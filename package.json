{
  "name": "@iden-q/scanner-cli",
  "version": "0.1.0",
  "description": "Command-line post-quantum cryptography exposure scanner — scan files, folders, and domains from your terminal or CI.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "yarn@3.2.1",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "q-scanner": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iden-q/iden-q-scanner-cli.git"
  },
  "scripts": {
    "build": "rm -rf dist dist-maps && node scripts/build.mjs && node scripts/obfuscate.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test",
    "changeset": "changeset",
    "release": "changeset publish",
    "verify:no-sourcemaps": "node scripts/verify-no-sourcemaps.mjs",
    "prepublishOnly": "yarn build && yarn verify:no-sourcemaps"
  },
  "dependencies": {
    "@iden-q/scanner-lib": "^0.1.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^20.19.42",
    "esbuild": "^0.28.1",
    "javascript-obfuscator": "^5.5.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
